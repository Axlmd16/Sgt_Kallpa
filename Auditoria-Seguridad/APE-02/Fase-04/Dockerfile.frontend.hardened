# ==============================================================================
# Dockerfile endurecido — FrontendFutbol (Kallpa UNL)
# APE 02, Fase 4 (Semana 8): Endurecimiento de contenedores Docker
#
# Prácticas aplicadas:
#   1. Imágenes base mínimas y con versión fija (node:20-alpine y
#      nginxinc/nginx-unprivileged:1-alpine, nunca :latest ni nginx:alpine genérico).
#   2. Usuario sin privilegios (USER 101 / nginx unprivileged, puerto 8080).
#   3. Exposición mínima de puertos (EXPOSE 8080) y exclusión de .env via .dockerignore.
# ==============================================================================

# ---------- Etapa 1: Build de producción ----------
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ARG VITE_API_URL=http://localhost:8001/api/v1
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---------- Etapa 2: Nginx sin privilegios ----------
FROM nginxinc/nginx-unprivileged:1-alpine

# Adaptar nginx.conf al puerto no privilegiado 8080 y aplicar parches de seguridad de Alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
USER root
RUN apk upgrade --no-cache \
    && sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/conf.d/default.conf \
    && chown -R 101:101 /etc/nginx/conf.d/default.conf

COPY --from=build --chown=101:101 /app/dist /usr/share/nginx/html

# Ejecutar como usuario sin privilegios (UID 101 = nginx)
USER 101

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
