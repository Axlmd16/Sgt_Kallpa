# ==============================================================================
# Dockerfile endurecido — BackendFutbol (Kallpa UNL)
# APE 02, Fase 4 (Semana 8): Endurecimiento de contenedores Docker
#
# Prácticas aplicadas:
#   1. Imagen base mínima con versión fija (sin etiquetas mutables como :latest)
#      y compilación multi-stage para excluir build-essential / headers del runtime.
#   2. Usuario sin privilegios (USER appuser, UID 10001) con permisos mínimos.
#   3. Exposición mínima de puertos (EXPOSE 8000) y exclusión de .env y archivos
#      sensibles mediante .dockerignore.
# ==============================================================================

# ---------- Etapa 1: Construcción de dependencias ----------
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Herramientas de compilación solo en la etapa builder (no pasan a producción)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libffi-dev \
    libcairo2-dev \
    libgirepository1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Binario de uv fijado a versión concreta (sin :latest)
COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# ---------- Etapa 2: Imagen mínima de ejecución ----------
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Solo librerías compartidas de ejecución requeridas por WeasyPrint (sin compiladores)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    gir1.2-pango-1.0 \
    fonts-liberation \
    fonts-dejavu-core \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario y grupo sin privilegios (UID/GID fijos, sin shell interactiva)
RUN groupadd --gid 10001 appgroup \
    && useradd --uid 10001 --gid appgroup --no-create-home --shell /usr/sbin/nologin appuser

# Copiar únicamente el entorno virtual y el código fuente necesario (propiedad de appuser)
COPY --from=builder --chown=appuser:appgroup /app/.venv /app/.venv
COPY --chown=appuser:appgroup main.py ./
COPY --chown=appuser:appgroup app ./app
COPY --chown=appuser:appgroup scripts ./scripts

# Ejecutar siempre con usuario sin privilegios (prohibido root)
USER appuser

# Exposición mínima: únicamente el puerto HTTP de la API
EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
